{
  "name": "gitai-vscode",
  "displayName": "GitAI",
  "description": "AI-powered commit message and PR description generation for VS Code",
  "version": "0.1.0",
  "publisher": "gitai",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "git",
    "ai",
    "commit",
    "pull request",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitai.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "GitAI",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitai.generatePRDescription",
        "title": "Generate PR Description",
        "category": "GitAI",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gitai.previewCommit",
        "title": "Preview Commit Message",
        "category": "GitAI",
        "icon": "$(eye)"
      },
      {
        "command": "gitai.openConfig",
        "title": "Open Configuration",
        "category": "GitAI",
        "icon": "$(settings-gear)"
      },
      {
        "command": "gitai.initConfig",
        "title": "Initialize GitAI Configuration",
        "category": "GitAI",
        "icon": "$(file-add)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitai.generateCommitMessage",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "gitai.generatePRDescription",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "gitai.previewCommit",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "gitai.openConfig"
        },
        {
          "command": "gitai.initConfig",
          "when": "gitOpenRepositoryCount != 0"
        }
      ],
      "scm/title": [
        {
          "command": "gitai.generateCommitMessage",
          "group": "navigation@1",
          "when": "scmProvider == git"
        },
        {
          "command": "gitai.previewCommit",
          "group": "navigation@2",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "GitAI",
      "properties": {
        "gitai.provider": {
          "type": "string",
          "enum": ["openai", "anthropic", "ollama", "lmstudio"],
          "default": "openai",
          "description": "AI provider to use for generating content"
        },
        "gitai.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "Model name to use with the selected provider"
        },
        "gitai.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the selected provider (stored securely)"
        },
        "gitai.template": {
          "type": "string",
          "default": "conventional",
          "description": "Template to use for generating content"
        },
        "gitai.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show preview before applying generated content"
        },
        "gitai.maxTokens": {
          "type": "number",
          "default": 500,
          "description": "Maximum tokens for AI generation"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitai/gitai.git"
  },
  "license": "MIT"
}